<section id="generador" class="surface generator-panel p-4 sm:p-6 md:p-7" aria-labelledby="generator-title">
  <div class="relative z-10 flex flex-col gap-4">
    <div class="generator-heading">
      <div class="flex items-center gap-3 min-w-0">
        <span class="icon-box" aria-hidden="true">
          <!-- Modern Sliders / Engine Icon -->
          <svg class="generator-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="6" y2="6"/>
            <line x1="4" x2="20" y1="12" y2="12"/>
            <line x1="4" x2="20" y1="18" y2="18"/>
            <circle cx="9" cy="6" r="2.25" fill="var(--card-inset)"/>
            <circle cx="15" cy="12" r="2.25" fill="var(--card-inset)"/>
            <circle cx="8" cy="18" r="2.25" fill="var(--card-inset)"/>
          </svg>
        </span>
        <div class="min-w-0">
          <p class="eyebrow mb-0.5">Motor CSPRNG</p>
          <h2 id="generator-title" class="m-0 text-lg font-bold tracking-tight truncate">Generador de contraseñas</h2>
        </div>
      </div>
      <div class="generator-badges">
        <span id="char-badge" class="badge">20 caracteres</span>
        <span id="entropy" class="badge badge-accent">— bits</span>
      </div>
    </div>

    <div class="password-output">
      <div class="min-w-0 flex-1">
        <output id="password-output" class="password-text" aria-live="polite">Generando una clave segura...</output>
        <p id="engine-source" class="mt-1.5 text-xs text-muted">Generada con una fuente criptográficamente segura</p>
      </div>
      <div class="generator-actions flex shrink-0 items-center gap-2">
        <button id="visibility-button" class="icon-button" type="button" aria-label="Ocultar contraseña en pantalla" title="Ocultar o mostrar contraseña">
          <svg id="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <svg id="eye-closed" class="hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
            <line x1="2" x2="22" y1="2" y2="22"/>
          </svg>
        </button>
        <button id="refresh-button" class="icon-button" type="button" aria-label="Generar otra contraseña" title="Generar otra contraseña">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
            <path d="M8 16H3v5"/>
          </svg>
        </button>
        <button id="copy-button" class="button button-secondary copy-btn" type="button">
          <svg id="copy-icon" viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <svg id="copied-icon" class="hidden" viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span id="copy-text">Copiar</span>
        </button>
      </div>
    </div>

    <div class="strength-block">
      <div class="strength-header mb-1.5 text-xs">
        <span id="strength-label" class="font-semibold text-accent">Fortaleza estimada</span>
        <span id="crack-time" class="font-mono text-muted text-right">Calculando...</span>
      </div>
      <div class="meter" role="meter" aria-label="Indicador de fortaleza" aria-valuemin="1" aria-valuemax="4" aria-valuenow="3">
        <span id="bar-1"></span>
        <span id="bar-2"></span>
        <span id="bar-3"></span>
        <span id="bar-4"></span>
      </div>
      <p id="entropy-note" class="metric-note">Estimación matemática para selección uniforme del alfabeto activo (10¹¹ intentos/s).</p>
    </div>

    <div class="control-card">
      <div class="length-header mb-3">
        <label for="length" class="text-sm font-semibold">Longitud de la contraseña</label>
        <div class="number-control">
          <button id="decrease" type="button" aria-label="Disminuir longitud">−</button>
          <input id="length-number" type="number" min="12" max="128" value="20" aria-label="Longitud en número de caracteres" />
          <button id="increase" type="button" aria-label="Aumentar longitud">+</button>
        </div>
      </div>
      <input id="length" class="range" type="range" min="12" max="128" value="20" />
      <div class="mt-1.5 flex justify-between text-xs text-muted">
        <span>12 mín.</span>
        <span>48</span>
        <span>88</span>
        <span>128 máx.</span>
      </div>
    </div>

    <fieldset class="m-0 border-0 p-0">
      <legend class="sr-only">Tipos de caracteres incluidos</legend>
      <div class="check-grid compact-checks">
        <label class="check-label"><input type="checkbox" data-option="lowercase" checked /> <span>Minúsculas <small>a-z</small></span></label>
        <label class="check-label"><input type="checkbox" data-option="uppercase" checked /> <span>Mayúsculas <small>A-Z</small></span></label>
        <label class="check-label"><input type="checkbox" data-option="digits" checked /> <span>Números <small>0-9</small></span></label>
        <label class="check-label"><input type="checkbox" data-option="symbols" checked /> <span>Símbolos <small>!@#</small></span></label>
      </div>
    </fieldset>

    <p id="generator-error" class="error-banner hidden" role="alert"></p>
    <button id="generate-button" class="button button-primary w-full py-3" type="button">Generar nueva contraseña</button>
    <a class="storage-cta" href="#guardar">¿Ya la generaste? Revisa cómo almacenarla de forma segura →</a>
  </div>
</section>

<script>
  const MIN_LEN = 12;
  const MAX_LEN = 128;
  const GUESSES_PER_SECOND = 100_000_000_000;
  const POOLS: Record<string, string> = {
    lowercase: "abcdefghijklmnopqrstuvwxyz",
    uppercase: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    digits: "0123456789",
    symbols: "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~",
  };

  const apiUrl = import.meta.env.PUBLIC_API_URL || "/api";
  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const output = $<HTMLOutputElement>("#password-output");
  const engineSource = $<HTMLElement>("#engine-source");
  const lengthInput = $<HTMLInputElement>("#length");
  const lengthNumber = $<HTMLInputElement>("#length-number");
  const lengthValue = $<HTMLElement>("#char-badge");
  const entropyBadge = $<HTMLElement>("#entropy");
  const entropyNote = $<HTMLElement>("#entropy-note");
  const errorBox = $<HTMLElement>("#generator-error");
  const generateButton = $<HTMLButtonElement>("#generate-button");
  const refreshButton = $<HTMLButtonElement>("#refresh-button");
  const copyButton = $<HTMLButtonElement>("#copy-button");
  const copyIcon = $<SVGElement>("#copy-icon");
  const copiedIcon = $<SVGElement>("#copied-icon");
  const copyText = $<HTMLElement>("#copy-text");
  const visibilityButton = $<HTMLButtonElement>("#visibility-button");
  const eyeOpen = $<SVGElement>("#eye-open");
  const eyeClosed = $<SVGElement>("#eye-closed");
  const meterEl = $<HTMLElement>(".meter");
  const optionInputs = Array.from(document.querySelectorAll<HTMLInputElement>("[data-option]"));

  let currentController: AbortController | null = null;
  let currentPassword = "";
  let isMasked = false;

  const renderOutput = () => {
    if (!output || !currentPassword) return;
    output.textContent = isMasked ? "•".repeat(currentPassword.length) : currentPassword;
  };

  const getOptions = (): Record<string, boolean> =>
    Object.fromEntries(optionInputs.map((input) => [input.dataset.option || "", input.checked]));

  const calculateAlphabetSize = (options: Record<string, boolean>): number =>
    (options.lowercase ? 26 : 0) +
    (options.uppercase ? 26 : 0) +
    (options.digits ? 10 : 0) +
    (options.symbols ? 32 : 0);

  const calculateLocalEntropy = (length: number, alphabetSize: number): number =>
    alphabetSize > 1 ? Math.round(length * Math.log2(alphabetSize) * 10) / 10 : 0;

  const calculateYears = (entropyBits: number): number => {
    const seconds = Math.pow(2, Math.min(entropyBits, 1000)) / GUESSES_PER_SECOND;
    return Math.round((seconds / (60 * 60 * 24 * 365.25)) * 10) / 10;
  };

  const cryptoRandomInt = (maxExclusive: number): number => {
    const array = new Uint32Array(1);
    const limit = Math.floor(0x100000000 / maxExclusive) * maxExclusive;
    let value = 0;
    do {
      window.crypto.getRandomValues(array);
      value = array[0];
    } while (value >= limit);
    return value % maxExclusive;
  };

  const generateLocalFallback = (length: number, options: Record<string, boolean>): string => {
    const activePools = Object.entries(POOLS)
      .filter(([key]) => options[key])
      .map(([, chars]) => chars);
    const chars = activePools.map((pool) => pool[cryptoRandomInt(pool.length)]);
    const alphabet = activePools.join("");
    for (let i = chars.length; i < length; i++) {
      chars.push(alphabet[cryptoRandomInt(alphabet.length)]);
    }
    for (let i = chars.length - 1; i > 0; i--) {
      const j = cryptoRandomInt(i + 1);
      [chars[i], chars[j]] = [chars[j], chars[i]];
    }
    return chars.join("");
  };

  const setLength = (value: number): number => {
    const numeric = Number.isFinite(value) ? Math.round(value) : 20;
    const safe = Math.max(MIN_LEN, Math.min(MAX_LEN, numeric));
    if (lengthInput) lengthInput.value = String(safe);
    if (lengthNumber) lengthNumber.value = String(safe);
    if (lengthValue) lengthValue.textContent = `${safe} caracteres`;
    return safe;
  };

  const updateMeter = (entropyBits: number, years?: number) => {
    const bars = [$("#bar-1"), $("#bar-2"), $("#bar-3"), $("#bar-4")];
    const active = entropyBits >= 120 ? 4 : entropyBits >= 80 ? 3 : entropyBits >= 60 ? 2 : 1;
    const labels: Record<number, string> = {
      1: "Fortaleza básica",
      2: "Fortaleza aceptable",
      3: "Fortaleza alta",
      4: "Fortaleza excelente",
    };

    bars.forEach((bar, index) => {
      if (bar) bar.className = index < active ? "active" : "";
    });
    if (meterEl) meterEl.setAttribute("aria-valuenow", String(active));

    const strengthLabel = $("#strength-label");
    if (strengthLabel) strengthLabel.textContent = labels[active];

    const crack = $("#crack-time");
    const estimatedYears = years !== undefined ? years : calculateYears(entropyBits);
    if (crack) {
      crack.textContent =
        estimatedYears >= 1e12
          ? "Más de 10¹² años estimados"
          : estimatedYears < 1
            ? "Menos de 1 año estimado"
            : `${new Intl.NumberFormat("es-ES").format(estimatedYears)} años estimados`;
    }
  };

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  };

  const hideError = () => {
    errorBox?.classList.add("hidden");
  };

  // Generación fluida sin parpadeo de formulario
  const generate = async (isManualClick = false) => {
    if (!lengthInput || !output || !entropyBadge) return;

    if (currentController) {
      currentController.abort();
    }
    const controller = new AbortController();
    currentController = controller;

    const length = setLength(Number(lengthInput.value));
    const options = getOptions();
    const alphabetSize = calculateAlphabetSize(options);
    const previewEntropy = calculateLocalEntropy(length, alphabetSize);

    updateMeter(previewEntropy);
    hideError();

    // Solo animar botón de refrescar cuando el usuario hace clic manual
    if (isManualClick && refreshButton) {
      refreshButton.classList.add("is-spinning");
    }

    try {
      const response = await fetch(`${apiUrl}/passwords`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ length, ...options }),
        signal: controller.signal,
      });

      const contentType = response.headers.get("content-type") || "";
      if (!contentType.includes("application/json")) {
        throw new Error("API_UNAVAILABLE");
      }

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.error || "No se pudo generar la contraseña.");
      }

      currentPassword = data.password;
      renderOutput();
      entropyBadge.textContent = `${data.entropy} bits`;
      if (entropyNote && data.entropy_note) {
        entropyNote.textContent = `${data.entropy_note} (10¹¹ intentos/s).`;
      }
      if (engineSource) {
        engineSource.textContent = "Generada con Python secrets (API Flask)";
      }
      updateMeter(data.entropy, data.estimated_exhaustive_years);
    } catch (requestError) {
      if (requestError instanceof DOMException && requestError.name === "AbortError") {
        return;
      }
      const message = requestError instanceof Error ? requestError.message : "";
      if (message === "API_UNAVAILABLE" || requestError instanceof TypeError) {
        currentPassword = generateLocalFallback(length, options);
        renderOutput();
        entropyBadge.textContent = `${previewEntropy} bits`;
        if (engineSource) {
          engineSource.textContent = "Generada localmente con Web Crypto CSPRNG (modo sin conexión)";
        }
        updateMeter(previewEntropy, calculateYears(previewEntropy));
      } else {
        showError(message || "Error al generar la contraseña.");
      }
    } finally {
      if (currentController === controller && refreshButton) {
        setTimeout(() => refreshButton.classList.remove("is-spinning"), 450);
      }
    }
  };

  let isTogglingVisibility = false;

  visibilityButton?.addEventListener("click", () => {
    if (isTogglingVisibility || !output) return;
    isTogglingVisibility = true;

    // Fase 1: Suave atenuación óptica sin saltos de escala ni desplazamiento de glifos
    output.classList.remove("password-restoring");
    output.classList.add("password-dimming");

    setTimeout(() => {
      // Fase 2: Conmutar el texto en el punto más tenue
      isMasked = !isMasked;
      eyeOpen?.classList.toggle("hidden", isMasked);
      eyeClosed?.classList.toggle("hidden", !isMasked);
      visibilityButton.setAttribute(
        "aria-label",
        isMasked ? "Mostrar contraseña en pantalla" : "Ocultar contraseña en pantalla"
      );
      renderOutput();

      // Fase 3: Restauración fluida a nitidez plena
      output.classList.remove("password-dimming");
      output.classList.add("password-restoring");

      setTimeout(() => {
        output.classList.remove("password-restoring");
        isTogglingVisibility = false;
      }, 280);
    }, 150);
  });

  lengthInput?.addEventListener("input", () => {
    const len = setLength(Number(lengthInput.value));
    const entropyBits = calculateLocalEntropy(len, calculateAlphabetSize(getOptions()));
    if (entropyBadge) entropyBadge.textContent = `${entropyBits} bits`;
    updateMeter(entropyBits);
  });

  lengthInput?.addEventListener("change", () => {
    setLength(Number(lengthInput.value));
    generate(false);
  });

  lengthNumber?.addEventListener("change", () => {
    setLength(Number(lengthNumber.value));
    generate(false);
  });

  $("#decrease")?.addEventListener("click", () => {
    setLength(Number(lengthInput?.value) - 1);
    generate(false);
  });

  $("#increase")?.addEventListener("click", () => {
    setLength(Number(lengthInput?.value) + 1);
    generate(false);
  });

  optionInputs.forEach((checkbox) => {
    checkbox.addEventListener("change", () => {
      const checkedCount = optionInputs.filter((input) => input.checked).length;
      if (checkedCount === 0) {
        checkbox.checked = true;
        showError("Debe permanecer al menos un tipo de carácter activo.");
        return;
      }
      generate(false);
    });
  });

  generateButton?.addEventListener("click", () => generate(true));
  refreshButton?.addEventListener("click", () => generate(true));

  copyButton?.addEventListener("click", async () => {
    if (!currentPassword) return;
    try {
      await navigator.clipboard.writeText(currentPassword);
      copyIcon?.classList.add("hidden");
      copiedIcon?.classList.remove("hidden");
      if (copyText) copyText.textContent = "¡Copiada!";
      copyButton.classList.add("copied-active");
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        copiedIcon?.classList.add("hidden");
        if (copyText) copyText.textContent = "Copiar";
        copyButton.classList.remove("copied-active");
      }, 1500);
    } catch {
      if (copyText) copyText.textContent = "Copia manual";
    }
  });

  generate(false);
</script>
